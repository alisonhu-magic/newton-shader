{
  "name": "newton-shader",
  "version": "1.0.0",
  "description": "Designer studio for Newton Labs brand fields — custom canvas sizes, image-driven patterns, and PNG / WebP / MP4 export.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "npx --yes http-server -p 4173 -c-1 .",
    "build": "node tools/build.js",
    "build:check": "node tools/build.js --check",
    "lint": "eslint .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:parity": "playwright test tests/parity.spec.js",
    "test:parity:update": "UPDATE_BASELINE=1 playwright test tests/parity.spec.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alisonhu-magic/newton-shader.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alisonhu-magic/newton-shader/issues"
  },
  "homepage": "https://github.com/alisonhu-magic/newton-shader#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "eslint-plugin-html": "^8.2.0",
    "globals": "^17.12.0"
  }
}
